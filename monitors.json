    "url": "https://queer-refugees.de/wp-json/qr-feed/v1/events?period=past&limit=1",
    "group": "QRD",
    "interval": 3600,
    "headers": "{\"X-API-Key\": \"${QRD_FEED_API_KEY}\"}",
    "jsonPath": "$join($sort($keys($)), \",\") & \"||\" & $join($sort($keys($.events[0])), \",\")",
    "jsonPathOperator": "==",
